# ============================================================
# Phase 17 - Streamlit UI container
# ============================================================
#
# Separate from Dockerfile.api so the interactive dashboard and
# the REST API can be deployed/scaled independently if needed.
# docker-compose.yml runs both together for local development.

FROM python:3.11-slim

# Tesseract is a system binary pytesseract calls out to - it is
# not installable via pip, hence this apt-get step.
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt \
    && python -m spacy download en_core_web_sm

COPY . .

# uploads/, extracted_text/, annotations/, api_documents/ are
# created automatically at runtime by the app's own
# os.makedirs() calls - no need to pre-create them here.

EXPOSE 8501

CMD ["streamlit", "run", "app.py", "--server.port=8501", "--server.address=0.0.0.0"]